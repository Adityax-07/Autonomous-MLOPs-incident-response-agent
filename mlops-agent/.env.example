# mlops-agent/.env.example
# Copy this file to .env and fill in the values.
# Never commit .env to version control.
#
#   cp .env.example .env

# ── Slack alerting ─────────────────────────────────────────────────────────────
# Create an Incoming Webhook in your Slack app settings:
# https://api.slack.com/messaging/webhooks
# Leave empty to use file-based fallback (alerts/alert_*.json)
SLACK_WEBHOOK_URL=

# ── Anthropic (Claude Haiku — LLM reasoning mode) ─────────────────────────────
# Only needed when AGENT_MODE=llm.  Falls back to rule-based if not set.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Agent mode ─────────────────────────────────────────────────────────────────
# "rule_based" (default): deterministic threshold logic, no API key needed
# "llm":                  Claude Haiku via Anthropic SDK, falls back to rule-based
AGENT_MODE=rule_based

# ── MLflow ────────────────────────────────────────────────────────────────────
# Inside Docker Compose, services use the service name as hostname.
# Locally (outside Docker), use http://localhost:5000 after starting mlflow-server.
MLFLOW_TRACKING_URI=http://mlflow-server:5000

# ── FastAPI hot-reload ────────────────────────────────────────────────────────
# agent-runner calls this URL to swap the in-memory model after retraining.
# Inside Docker: use the service name.  Locally: http://localhost:8000/reload
FASTAPI_RELOAD_URL=http://fastapi-server:8000/reload

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ── Grafana dashboard links ───────────────────────────────────────────────────
# Base URL embedded in Slack alert "Open Grafana" button
GRAFANA_URL=http://localhost:3000

# ── Monitor scheduler ────────────────────────────────────────────────────────
# Override the path agent monitor_node reads (useful for testing)
# LATEST_REPORT_PATH=/app/monitor/latest_report.json
# MAX_REPORT_AGE_SECONDS=600
